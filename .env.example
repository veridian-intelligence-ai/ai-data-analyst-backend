# AI Data Analyst API — environment template.
# Copy to .env and fill every __SET_ME__. The service fails fast at boot on
# missing required values (see app/config.py) — that is intentional.

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection URL from your managed provider (Railway, RDS, ...).
DATABASE_URL=__SET_ME__
# Connection pool sizing. Budget DB_POOL_MAX against the SHARED server-side
# connection limit across ALL services/replicas pointing at this database.
DB_POOL_MIN=1
DB_POOL_MAX=10
# Seconds a request waits for a free connection before returning 503.
DB_POOL_TIMEOUT=10

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated EXPLICIT origins of the frontend. No wildcard — this API
# uses credentialed requests. Example: https://analyst.acme.example
ALLOWED_ORIGINS=__SET_ME__

# ── Auth (WorkOS) ───────────────────────────────────────────────────────
# API key from the WorkOS dashboard (secret — server side only).
WORKOS_API_KEY=__SET_ME__
# Client id of your WorkOS environment.
WORKOS_CLIENT_ID=__SET_ME__
# Lifetime of our opaque session tokens, in hours.
AUTH_TOKEN_EXPIRE_HOURS=24

# ── Admin ───────────────────────────────────────────────────────────────
# Shared secret for POST /admin/users (X-Admin-Key header). Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=__SET_ME__

# ── LLM (Anthropic) ─────────────────────────────────────────────────────
# API key for the Anthropic SDK (read implicitly by anthropic.Anthropic()).
ANTHROPIC_API_KEY=__SET_ME__
# DAX-generation model (ADR-011: strong model for query generation — the
# fast tier failed the DAX bake-off; re-run bake-offs before switching).
ANTHROPIC_MODEL=claude-sonnet-4-5
# LLM client timeout, seconds. Cascade rule: keep BELOW the frontend's 90s
# (LLM 85 < frontend 90 < edge ~100). Overridable for failure drills only.
# ANTHROPIC_TIMEOUT_SECONDS=85

# ── Power BI ────────────────────────────────────────────────────────────
# Microsoft Entra tenant id of the organization that owns the workspace.
POWERBI_TENANT_ID=__SET_ME__
# App registration (service principal) client id.
POWERBI_CLIENT_ID=__SET_ME__
# App registration client secret (rotate on your tenant's schedule).
POWERBI_CLIENT_SECRET=__SET_ME__
# Workspace (group) id containing the semantic model.
POWERBI_WORKSPACE_ID=__SET_ME__
# Semantic model (dataset) id the analyst queries.
POWERBI_DATASET_ID=__SET_ME__
# Human-friendly model name, used in the system prompt.
DATASET_DISPLAY_NAME=__SET_ME__

# ── App ─────────────────────────────────────────────────────────────────
# IANA timezone for the date context injected into each conversation.
APP_TIMEZONE=UTC
# "true" enables the debug payload on /chat (raw DAX, rows, iteration logs).
# Keep FALSE in production — this is internal detail, gated on purpose.
APP_DEBUG_PAYLOADS=false
# Listen port (set automatically by most platforms; used by the Dockerfile).
PORT=8000
